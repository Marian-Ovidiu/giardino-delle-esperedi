# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# testing & QA
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# scratch
/.tmp/
.verify-*.mjs

# editors
/.idea/
/.vscode/
*.swp

# Local agent settings are machine-specific. The four project agents in
# .claude/agents/ ARE tracked — they are part of the deliverable.
.claude/settings.local.json

# Higgsfield generation masters: 41MB of rejected candidates across Batch 0
# and Batch 1R. The per-candidate rejection record lives in
# docs/assets-manifest.md, which is what actually needs to survive.
# Tracked deliberately: assets/refs/ (the locked colour reference every future
# plate is graded against) and assets/archive/ (superseded but approved
# derivatives, 148KB — the audit trail).
/assets/masters/

# 115MB of QA screenshots, regenerable with `npm run shots`.
/docs/captures/

# Original font downloads are retained locally only; the production sources
# are the Latin WOFF2 files beside them.
/src/assets/fonts/*.ttf
!/src/assets/fonts/LeagueSpartan-Variable.ttf
/assets/brand/
